# Environment Configuration for Secure Image Gallery
# Student: Sahana & Samudyata
# Cloud Project: Secure Image Gallery using AWS S3 & EC2

SECRET_KEY=sahana-cloud-security-key-2026-s3-gallery

# Storage Mode: 'local' for offline localhost testing, 'aws' for Amazon S3 deployment
STORAGE_BACKEND=local

# AWS S3 Settings (Required if STORAGE_BACKEND=aws)
AWS_REGION=us-east-1
AWS_S3_BUCKET=sahana-secure-image-gallery
# On EC2 with IAM Role attached, leave credentials empty to leverage IAM Role instance metadata!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server Settings
PORT=5000
DEBUG=True
