# Environment Configuration Template
# Project: Secure Image Gallery using AWS S3 & EC2
# Student: Sahana (Reg. No: 24UG00224)

SECRET_KEY=replace-with-a-secure-random-key-in-production

# Storage Mode: 'aws' for Amazon S3 deployment, 'local' for offline emulation
STORAGE_BACKEND=aws

# AWS S3 Settings (Auto-discovered on EC2 via IAM Instance Profile)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=sahana-secure-image-gallery

# On EC2 with IAM Role attached, leave credentials empty to leverage IAM Role instance metadata!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server Settings
PORT=5000
DEBUG=False
